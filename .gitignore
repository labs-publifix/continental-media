node_modules/
__pycache__/
.DS_Store

# Draft/test blog article previews and their OG images/PDFs
# (`node scripts/blog/generate-*.mjs --drafts`) — never part of the
# production build, never committed.
public/blog/_drafts/
public/assets/images/blog/og/_drafts/
public/assets/pdfs/blog/_drafts/

# Review previews for one real in-progress post by id (`node scripts/
# blog/generate-*.mjs --preview=<id>`) — e.g. an "En revisión" article
# before it's authorized to publish. Never part of the production
# build, never committed.
public/blog/_preview/
public/assets/images/blog/og/_preview/
public/assets/pdfs/blog/_preview/

# Old-site WordPress export (XML export + .sql dump) the user drops
# here for the SEO migration — see migracion/LEEME_transicion_seo.md.
# Explicitly NOT committed (1.8GB, includes wp-content/uploads).
migracion/respaldo/
